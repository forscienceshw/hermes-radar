# ---------------------------------------------------------------------------
# 这个仓库只跟踪"代码与模板"。凡是运行期产生、体积大、含个人隐私的东西
# 一律不进来 —— 它们由 data/ 目录自己承载，迁移时单独拷贝。
# ---------------------------------------------------------------------------

# 运行期数据：数据库、离线文档、图片 blob、日志、备份、临时目录
data/
analysis/
inbox/
.tmp/
.cache/
*.log
# 一次性排查脚本的落点（AGENTS.md 约定），写完即删，别入库
_scratch/

# 开发实例（v2 起用环境变量把数据/配置挪到这里，和正式实例隔开）
.devdata/
.devconfig/

# 密钥与本机路径：绝不入库。
# 注意 config/settings.json 是**入库**的 —— 里面只有阈值、词表、推送时段这类偏好，
# 没有密钥；让它进版本历史，改坏了才能一键回滚。
config/startup.json
config/secrets*.json

# 依赖与构建产物
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
node_modules/
cloud/dist/

# 打包产物与系统杂项
dist/
*.zip
Radar.exe
RadarSetup.exe
.DS_Store
Thumbs.db
desktop.ini
.tmpdata/
