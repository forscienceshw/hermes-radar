{
  "schema_version": 1,
  "host": "127.0.0.1",
  "port": 8766,
  "worker_concurrency": 3,
  "default_poll_seconds": 300,
  "request_timeout_seconds": 35,
  "max_html_mb": 25,
  "http_proxy": "",
  "auto_update_check": true,
  "update_mirror": "",
  "max_images_per_article": 12,
  "max_image_mb": 6,
  "image_triage_enabled": true,
  "image_triage_max": 20,
  "science_keywords": [
    "研究",
    "论文",
    "机制",
    "细胞",
    "蛋白",
    "基因",
    "实验",
    "临床",
    "综述",
    "Nature",
    "Science",
    "Cell",
    "DOI",
    "研究进展",
    "研究发现",
    "前沿",
    "research",
    "study",
    "abstract",
    "methods",
    "results",
    "experiment",
    "clinical",
    "protein",
    "genome",
    "mechanism",
    "review",
    "trial",
    "preprint",
    "journal",
    "scientific",
    "analysis",
    "therapy",
    "neuron",
    "molecular"
  ],
  "exclude_keywords": [
    "广告",
    "推广",
    "课程报名",
    "招聘"
  ],
  "llm": {
    "enabled": true,
    "provider": "workbuddy_cloud",
    "base_url": "https://api.deepseek.com/v1",
    "model": "glm-5.3-flash",
    "vision_enabled": true,
    "timeout_seconds": 900,
    "stall_seconds": 300,
    "max_input_chars": 80000,
    "min_local_relevance": 40,
    "long_material_strategy": "head_tail",
    "max_ideas": 8,
    "max_images": 6,
    "daily_call_limit": 5000,
    "chat_context_tokens": 0,
    "accounts": []
  },
  "papers": {
    "enabled": true,
    "email": "",
    "max_pdf_mb": 100,
    "max_per_item": 10,
    "extract_text": true,
    "download_references": false,
    "title_lookup": true
  },
  "notifications": {
    "enabled": true,
    "channel": "wecom_webhook",
    "batch_size": 8,
    "max_wait_minutes": 180,
    "instant_threshold": 88,
    "min_relevance": 20,
    "min_interval_seconds": 600,
    "quiet_start": "23:30",
    "quiet_end": "07:30",
    "quiet_allow_critical": true,
    "send_windows": [
      "08:30",
      "13:00",
      "20:30"
    ],
    "max_per_day": 3,
    "highlight_threshold": 74,
    "digest_limit": 10,
    "focus_topics": [
      "DNA 合成",
      "RNA 合成",
      "纳米结构",
      "适配体",
      "传感器",
      "神经科学",
      "结构生物学"
    ]
  },
  "video": {
    "asr_enabled": true,
    "asr_model": "small",
    "asr_device": "auto",
    "keep_audio": false,
    "max_duration_minutes": 180
  },
  "analysis": {
    "custom_reading_prompt": "",
    "prompt_version": "research-reader-v2",
    "concurrency": 4
  }
}